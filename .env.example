# PostgreSQL (docker-compose)
POSTGRES_USER=aviso
POSTGRES_PASSWORD=aviso_dev_password
POSTGRES_DB=aviso

# Prisma
DATABASE_URL=postgresql://aviso:aviso_dev_password@localhost:5432/aviso

# Auth.js — generate with: npx auth secret  (use AUTH_SECRET, not BETTER_AUTH_SECRET)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Optional — override bot username for deep links (otherwise resolved from BOT_TOKEN)
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=aviso_me_bot

# Public site URL for SEO (sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram Bot API
BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
